# ==============================================================================
# SEVA·GIS — Spatial Evaluation & Vegetation Analytics
# Master Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting local development or cloud build.
# For production deployments, these variables are injected via Google Cloud Run,
# Firebase Hosting, and GitHub Actions Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE CLOUD RUN — EARTH ENGINE BACKEND MICROSERVICE
# ------------------------------------------------------------------------------
# Live Production Cloud Run Microservice URL (FastAPI Earth Engine Proxy)
VITE_EE_API_URL=https://seva-gis-backend-419602015618.us-central1.run.app

# Google Cloud Platform (GCP) Project Details
GCP_PROJECT_ID=seva-gis-backend
GCP_PROJECT_NUMBER=419602015618
GCP_REGION=us-central1
GCP_CLOUD_RUN_SERVICE=seva-gis-backend

# Cloud Run Container Execution Port (injected dynamically by Cloud Run)
PORT=8080

# Dedicated Cloud Run Execution Service Account
GCP_SERVICE_ACCOUNT=seva-gis-runner@seva-gis-backend.iam.gserviceaccount.com

# Microservice Interactive Documentation & Health Probe URLs
# - Swagger UI:   https://seva-gis-backend-419602015618.us-central1.run.app/api/docs
# - ReDoc:        https://seva-gis-backend-419602015618.us-central1.run.app/api/redoc
# - Health Check: https://seva-gis-backend-419602015618.us-central1.run.app/health

# ------------------------------------------------------------------------------
# 2. GOOGLE EARTH ENGINE (GEE) CONFIGURATION
# ------------------------------------------------------------------------------
# Google Earth Engine Registered Cloud Project ID
EE_PROJECT_ID=seva-gis-backend

# Primary Earth Observation Datasets Ingested:
# - S2 L2A Surface Reflectance: COPERNICUS/S2_SR_HARMONIZED
# - Scene Classification Layer: SCL (Flags 4-7 cloud/shadow/snow masking)
# - Global Elevation 30m DEM:   COPERNICUS/DEM/GLO30

# Backend Rate Limiting (Requests Per Minute per IP) & Tile Cache TTL (Seconds)
EE_RATE_LIMIT_RPM=60
EE_CACHE_TTL=600

# ------------------------------------------------------------------------------
# 3. FIREBASE PRODUCTION HOSTING & EDGE CDN
# ------------------------------------------------------------------------------
# Live Firebase Hosting Project ID (Global Edge CDN)
VITE_FIREBASE_PROJECT_ID=seva-gis-backend-e724a
VITE_FIREBASE_PROJECT_NUMBER=96520749785

# Live Production Web App Domains
VITE_PUBLIC_APP_URL=https://seva-gis-backend-e724a.web.app
VITE_MIRROR_APP_URL=https://seva-gis-backend-e724a.firebaseapp.com

# Firebase Authentication & Cloud Storage Domain Configuration
VITE_FIREBASE_AUTH_DOMAIN=seva-gis-backend-e724a.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=seva-gis-backend-e724a.appspot.com

# Optional Firebase Web Client Credentials (Leave blank for standalone mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google OAuth 2.0 Web Client ID (Google Cloud Console > APIs & Services > Credentials)
# Required for authentic Google Sign-in & Google Drive cloud backup
# Format: <project-number>-<random-hash>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) WHITELIST
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origin domains permitted to request GEE tiles
EE_ALLOWED_ORIGINS=https://seva-gis-backend-e724a.web.app,https://seva-gis-backend-e724a.firebaseapp.com,http://localhost:8443,http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# 5. EXTERNAL GEOSPATIAL & AGRO-METEOROLOGY APIS (FREE / OPEN ACCESS)
# ------------------------------------------------------------------------------
# Open-Meteo High-Resolution Forecast & Evapotranspiration (ET0) API
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Copernicus Data Space STAC Catalogue (ESA Sentinel-2)
VITE_COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac

# Microsoft Planetary Computer STAC API (Sentinel-2 Cloud-Optimized GeoTIFFs)
VITE_PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# ISRIC SoilGrids REST API (Digital Soil Mapping 250m)
VITE_SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0

# OpenRouteService Isochrones & Reachability API (Optional API Key)
# Sign up at https://openrouteservice.org/ for an access token
VITE_ORS_API_KEY=

# ------------------------------------------------------------------------------
# 6. GITHUB CI/CD CONTINUOUS DEPLOYMENT SECRETS (FOR GITHUB ACTIONS)
# ------------------------------------------------------------------------------
# Configure these encrypted secrets under:
# https://github.com/virahitvin8/seva-gis/settings/secrets/actions
#
# - FIREBASE_SERVICE_ACCOUNT_SEVA_GIS_BACKEND_E724A: Generated by `firebase init hosting:github`
# - GCP_SA_KEY: Service Account JSON key for automated Cloud Run deployments
# ==============================================================================

# EmailOctopus report delivery (client-side)
VITE_EMAIL_OCTOPUS_API_KEY=
VITE_EMAIL_OCTOPUS_LIST_ID=15e4d8e2-c4b5-11f1-8441-836e7cd382aa

# ------------------------------------------------------------------------------
# 7. PRODUCTION DOMAINS, DESKTOP BRIDGES & SMTP DISPATCH
# ------------------------------------------------------------------------------
PUBLIC_APP_URL=https://sevagis.dpdns.org
ALLOWED_ORIGINS=https://sevagis.dpdns.org,https://seva-gis.easebot.org,https://easebot.dpdns.org,http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,tauri://localhost

# Real SMTP automated delivery (PDF/DOCX/ZIP/JSON attachments)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@sevagis.dpdns.org
SMTP_PASS=your-smtp-app-password
SMTP_FROM="SEVA.GIS Sahayak <notifications@sevagis.dpdns.org>"

# Local Desktop GIS Bridges
QGIS_BRIDGE_URL=http://127.0.0.1:8765
ARCGIS_PYTHON_PATH=C:/Python27/ArcGIS10.8/python.exe
ARCGIS_PRO_PYTHON_PATH=C:/Program Files/ArcGIS/Pro/bin/Python/envs/arcgispro-py3/python.exe
OCTAVE_CLI_PATH=octave-cli

# GitHub Automation Token (stored only locally in .env, never committed)
GITHUB_TOKEN=your_personal_access_token_here

