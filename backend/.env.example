# ==============================================================================
# SEVA·GIS — Google Earth Engine Proxy Backend (.env.example)
# ==============================================================================
# Service: seva-gis-backend (FastAPI / Uvicorn / Google Earth Engine Python API)
# Cloud Run: https://seva-gis-backend-419602015618.us-central1.run.app
# ==============================================================================

# 1. Google Cloud Platform & Earth Engine Project Identification
EE_PROJECT_ID=seva-gis-backend
GCP_PROJECT_ID=seva-gis-backend
GCP_PROJECT_NUMBER=419602015618
GCP_REGION=us-central1

# 2. Server Runtime Port (Injected automatically as 8080 by Cloud Run)
PORT=8080

# 3. CORS Allowed Origins Whitelist
# Include production Firebase CDN domains and local development servers
EE_ALLOWED_ORIGINS=https://seva-gis-backend-e724a.web.app,https://seva-gis-backend-e724a.firebaseapp.com,http://localhost:8443,http://localhost:5173,http://localhost:8080

# 4. In-Memory LRU Cache & Rate Limiting
# Maximum requests per minute per IP address
EE_RATE_LIMIT_RPM=60
# Tile metadata cache TTL in seconds (10 minutes)
EE_CACHE_TTL=600

# 5. Local Development Service Account Key (Optional)
# In Google Cloud Run, Application Default Credentials (ADC) are used automatically.
# For local offline debugging outside GCP, set GOOGLE_APPLICATION_CREDENTIALS:
# GOOGLE_APPLICATION_CREDENTIALS=backend/service-account.json
