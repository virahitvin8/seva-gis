{
  "name": "seva-gis",
  "displayName": "SEVA.GIS",
  "description": "Spatial Evaluation & Vegetation Analytics, Geographic Information System - Where Satellites Meet Soil",
  "license": "Apache-2.0",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server.js",
    "set-domain": "node scripts/set-domain.js",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting",
    "format": "oxfmt",
    "test": "node --import ./scripts/test-run.mjs --test \"src/**/*.test.ts\"",
    "bench:raster": "node scripts/bench-raster-stats.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "grill": "node scripts/grill.mjs",
    "grill:quick": "node scripts/grill.mjs --quick",
    "demo:assemble": "node scripts/video-pipeline/assemble.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@turf/buffer": "^7.4.0",
    "dexie": "^4.4.6",
    "geolib": "^3.3.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
